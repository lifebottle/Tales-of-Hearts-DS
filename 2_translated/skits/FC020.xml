    <Entry>
      <PointerOffset>13492</PointerOffset>
      <VoiceId>C2001</VoiceId>
      <JapaneseText>……&lt;Hisui&gt;兄さん！
……&lt;Hisui&gt;兄〜ちゃん♪
……&lt;Hisui&gt;兄貴∀</JapaneseText>
      <EnglishText>Hmm. 'Sup, bro! No no no...
What's up, broseph? That's not it either...
Greetings, dear brother.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
