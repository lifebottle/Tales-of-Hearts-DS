    </Entry>
    <Entry>
      <PointerOffset>16636</PointerOffset>
      <JapaneseText>&lt;Hisui&gt;……ありがと……</JapaneseText>
      <EnglishText>&lt;Hisui&gt;... thanks...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>12</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>17060</PointerOffset>
      <JapaneseText>おっと、礼なんか言うなよ</JapaneseText>
      <EnglishText>Oop, don't thank me just yet.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>13</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>17408</PointerOffset>
      <JapaneseText>俺はまだまだ
お前と&lt;Kohaku&gt;の仲を
認めてねぇ〜んだからな！</JapaneseText>
      <EnglishText>You know I still haven't given you two my blessing!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>14</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
