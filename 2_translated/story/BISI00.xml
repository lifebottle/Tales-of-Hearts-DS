      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>54604</PointerOffset>
      <JapaneseText>うぅ、だってちがうもん……
ちがうんだもんっっ!!</JapaneseText>
      <EnglishText>But it's not the same... it's not my mommy's!</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>21</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
