      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>50528</PointerOffset>
      <JapaneseText>で、でも匂いは
とっても美味しそうだよ</JapaneseText>
      <EnglishText>But it smells delicious!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>13</Id>
