    </Entry>
    <Entry>
      <PointerOffset>52512</PointerOffset>
      <JapaneseText>……&lt;Kohaku&gt;たちは
サトのオキテをやぶる
わりぃコなんだべ？</JapaneseText>
      <EnglishText>...&lt;Kohaku&gt; and &lt;Hisui&gt; are bad kids who broke the rules of the village?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <SubId>2</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>52512</PointerOffset>
      <JapaneseText>そんなわりぃコとクチを
きいちゃいけねぇんだよっ！</JapaneseText>
      <EnglishText>I don't want to talk to bad people!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <BubbleId>2</BubbleId>
      <SubId>2</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>52512</PointerOffset>
      <JapaneseText>……&lt;Kohaku&gt;たちは
いいコだったんだなぁ</JapaneseText>
      <EnglishText>...&lt;Kohaku&gt; and &lt;Hisui&gt; were good kids after all.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <SubId>3</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>52512</PointerOffset>
      <JapaneseText>わりぃコなんていって
ごめんよぅ……許してけろ</JapaneseText>
      <EnglishText>I'm sorry for calling you bad people... Please forgive me...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <SubId>4</SubId>
      <Status>Editing</Status>
