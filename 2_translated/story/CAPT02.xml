      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>76924</PointerOffset>
      <JapaneseText>……ん？
貴様らは……</JapaneseText>
      <EnglishText>...Hm? You...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>20</Id>
      <BubbleId>1</BubbleId>
      <SubId>3</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>76924</PointerOffset>
      <JapaneseText>どこかで見たような顔だな……??</JapaneseText>
      <EnglishText>Have I seen you somewhere before...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>20</Id>
