    <Entry>
      <PointerOffset>76556</PointerOffset>
      <JapaneseText>みはりをつづけるぞ！</JapaneseText>
      <EnglishText>Stay on lookout!</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>16</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>76556</PointerOffset>
      <JapaneseText>お兄ちゃんじゃない！
少佐とよべ!!</JapaneseText>
      <EnglishText>I'm not your brother! I'm your COMMANDER!</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
