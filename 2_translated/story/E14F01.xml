    <Entry>
      <PointerOffset>46912</PointerOffset>
      <JapaneseText>奪う……？</JapaneseText>
      <EnglishText>Steal...?</EnglishText>
      <Notes/>
      <SpeakerId>8</SpeakerId>
      <Id>16</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
