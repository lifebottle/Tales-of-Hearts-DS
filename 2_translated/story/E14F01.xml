    </Entry>
    <Entry>
      <PointerOffset>46928</PointerOffset>
      <JapaneseText>きみは何を奪われたの？
何も奪ってないよ</JapaneseText>
      <EnglishText>What was stolen from you?
I didn't steal anything.</EnglishText>
      <Notes/>
      <SpeakerId>8</SpeakerId>
      <Id>17</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47236</PointerOffset>
      <JapaneseText>あの子って……</JapaneseText>
      <EnglishText>That girl...</EnglishText>
      <Notes/>
      <SpeakerId>8</SpeakerId>
      <Id>18</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47252</PointerOffset>
      <JapaneseText>レーブ村にいたカリン？
何を言ってるか分からないよ</JapaneseText>
      <EnglishText>You mean Karin from Lof Village? 
No idea who you're talking about.</EnglishText>
      <Notes/>
      <SpeakerId>8</SpeakerId>
