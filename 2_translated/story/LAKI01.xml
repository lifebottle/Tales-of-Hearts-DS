      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <SubId>1</SubId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>58692</PointerOffset>
      <JapaneseText>許さないわよ、きみッ！</JapaneseText>
