    <Entry>
      <PointerOffset>28520</PointerOffset>
      <JapaneseText>ゼロムたちの行動パターンを
分析しているの</JapaneseText>
      <EnglishText>I'm studying the behavioral patterns of the xerom.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <BubbleId>1</BubbleId>
      <SubId>2</SubId>
